generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  USER
  RENTER
  OWNER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RenterVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OwnerVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MotoStatus {
  PENDING_APPROVAL
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  INACTIVE
  REJECTED
  STOLEN
  ACCIDENTED
  MISSING
}

enum RentalStatus {
  PENDING
  ACTIVE
  RETURNED
  COMPLETED
  CANCELLED
  INCIDENT
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum HandoverType {
  PICKUP
  RETURN
}

enum IncidentType {
  THEFT
  ACCIDENT
  DISAPPEARANCE
}

enum LegalDocType {
  TRANSIT_LICENSE
  SOAT
  TECHNICAL_REVIEW
  INSURANCE
}

// ----------------------------------------------------
// USER AND PROFILE MODELS
// ----------------------------------------------------

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  fullName  String
  phone     String
  role      Role     @default(USER)

  // Email verification
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  // Password recovery
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?

  // Profiles
  owner     Owner?
  renter    Renter?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// RENTER
// ----------------------------------------------------

model Renter {
  id                    String   @id @default(uuid())
  idUser                String   @unique

  // Personal identification
  cedulaNumero          String   @unique
  cedulaFrontUrl        String?
  cedulaBackUrl         String?
  photo                 String?

  // Driving license
  licenseNumber         String   @unique
  licenseFrontUrl       String?
  licenseBackUrl        String?
  licenseCategory       String
  licenseExpirationDate DateTime?

  // Proof of address
  billUrl               String?

  // Encrypted binary files (AES-256-GCM + gzip)
  documentFrontEnc      Bytes?
  documentBackEnc       Bytes?
  licenseFrontEnc       Bytes?
  licenseBackEnc        Bytes?

  // Verification
  estadoVerificacion    RenterVerificationStatus @default(PENDING)
  motivoRechazo         String?
  fechaVerificacion     DateTime?

  // Dates
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User     @relation(fields: [idUser], references: [id])
  rentals               Rental[]
}

// ----------------------------------------------------
// OWNER
// ----------------------------------------------------

model Owner {
  id                 String   @id @default(uuid())
  idUser             String   @unique

  // Personal identification (optional when created as pending on first moto publish)
  cedulaNumero       String?  @unique
  cedulaFrontUrl     String?
  cedulaBackUrl      String?
  photo              String?
  billUrl            String?

  // Verification
  estadoVerificacion OwnerVerificationStatus @default(PENDING)
  motivoRechazo      String?
  fechaVerificacion  DateTime?

  // Dates
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relations
  user               User     @relation(fields: [idUser], references: [id])
  motos              Moto[]
}

// ----------------------------------------------------
// VEHICLE MODELS
// ----------------------------------------------------

model Moto {
  id             String              @id @default(uuid())

  // If ownerId is null -> MotoRent company motorcycle
  // If ownerId has a value -> Private owner's motorcycle
  ownerId        String?
  owner          Owner?              @relation(fields: [ownerId], references: [id])

  brand          String
  model          String
  year           Int
  licensePlate   String              @unique
  displacement   String
  KM             Int
  color          String
  dailyRate      Decimal             @db.Decimal(10, 2)
  status         MotoStatus          @default(AVAILABLE)

  document       MotoDocument?
  legalDocuments MotoLegalDocument[]
  images         MotoImage[]
  rentals        Rental[]

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

// ----------------------------------------------------
// MOTO DOCUMENTS AND IMAGES
// ----------------------------------------------------

model MotoDocument {
  id                   String             @id @default(uuid())
  motoId               String             @unique
  transitLicenseNumber String             @unique
  transitLicenseImage  String
  verificationStatus   VerificationStatus @default(PENDING)
  verifiedAt           DateTime?

  moto       Moto     @relation(fields: [motoId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MotoLegalDocument {
  id                 String             @id @default(uuid())
  motoId             String
  type               LegalDocType
  number             String?
  expiresAt          DateTime?
  fileEnc            Bytes
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?

  moto Moto @relation(fields: [motoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([motoId, type])
}

model MotoImage {
  id        String   @id @default(uuid())
  motoId    String
  data      Bytes
  mime      String
  isPrimary Boolean  @default(false)

  moto Moto @relation(fields: [motoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// RENTAL, CONTRACT, CLAUSES AND HANDOVER MODELS
// ----------------------------------------------------

model Rental {
  id            String        @id @default(uuid())
  renterId      String
  motoId        String
  startDate     DateTime
  endDate       DateTime

  // Payment breakdown and commissions
  subtotal      Decimal
  platformFee   Decimal       @default(0)
  ownerEarnings Decimal       @default(0)
  total         Decimal

  status        RentalStatus  @default(PENDING)

  // Incidents (theft, accident, disappearance)
  incidentType  IncidentType?
  incidentNotes String?
  incidentAt    DateTime?

  renter        Renter        @relation(fields: [renterId], references: [id])
  moto          Moto          @relation(fields: [motoId], references: [id])

  contract      Contract?
  handovers     VehicleHandover[]
  clauses       RentalClause[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Contract {
  id             String         @id @default(uuid())
  rentalId       String         @unique
  contractNumber String         @unique
  status         ContractStatus @default(ACTIVE)
  accepted       Boolean        @default(false)
  acceptedAt     DateTime?
  observations   String?

  // Digital signature & integrity
  signatureEnc   Bytes?
  signedAt       DateTime?
  signedIp       String?
  documentHash   String?

  rental     Rental   @relation(fields: [rentalId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Clause {
  id        String         @id @default(uuid())
  title     String
  body      String         @db.Text
  version   Int            @default(1)
  active    Boolean        @default(true)

  rentals   RentalClause[]

  createdAt DateTime       @default(now())
}

model RentalClause {
  rentalId      String
  clauseId      String
  clauseVersion Int
  bodySnapshot  String   @db.Text
  acceptedAt    DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  clause Clause @relation(fields: [clauseId], references: [id])

  @@id([rentalId, clauseId])
}

model VehicleHandover {
  id           String             @id @default(uuid())
  rentalId     String
  type         HandoverType
  mileage      Int
  fuelLevel    Decimal
  observations String?

  rental      Rental             @relation(fields: [rentalId], references: [id])
  evidences   HandoverEvidence[]

  createdAt   DateTime           @default(now())
}

model HandoverEvidence {
  id          String          @id @default(uuid())
  handoverId  String

  fileUrl     String
  description String?

  handover    VehicleHandover @relation(fields: [handoverId], references: [id])

  createdAt   DateTime        @default(now())
}
